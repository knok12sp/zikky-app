+package expo.modules.audio
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class PlaybackGateTest {
+  @Test fun pausedQueueNeverAuthorizesAcquisition() {
+    val gate = PlaybackGate()
+    assertFalse(gate.accepts(gate.ticket(0), 0))
+    gate.invalidate()
+    assertFalse(gate.wantsPlayback)
+  }
+  @Test fun pauseDiscardsLateAcquisitionEvenAfterResume() {
+    val gate = PlaybackGate()
+    gate.play()
+    val old = gate.ticket(0)
+    assertTrue(gate.accepts(old, 0))
+    gate.pause()
+    gate.play()
+    assertFalse(gate.accepts(old, 0))
+    assertTrue(gate.accepts(gate.ticket(0), 0))
+  }
+  @Test fun skippingAndClearingInvalidateInFlightWork() {
+    val gate = PlaybackGate()
+    gate.play()
+    val old = gate.ticket(0)
+    gate.invalidate()
+    assertFalse(gate.accepts(old, 0))
+    assertFalse(gate.accepts(gate.ticket(1), 0))
+    gate.pause()
+    assertFalse(gate.accepts(gate.ticket(0), 0))
+  }
+}
