+package expo.modules.audio
+
+/** Invalidates asynchronous acquisition replies when the user pauses, skips or clears. */
+internal class PlaybackGate {
+  data class Ticket(val revision: Long, val index: Int)
+  private var revision = 0L
+  var wantsPlayback = false
+    private set
+  var stopAfterTrack = false
+  fun finishTrack(): Boolean {
+    if (!wantsPlayback || !stopAfterTrack) return false
+    stopAfterTrack = false
+    pause()
+    return true
+  }
+  fun play() { wantsPlayback = true }
+  fun invalidate() { revision++ }
+  fun pause() { wantsPlayback = false; invalidate() }
+  fun ticket(index: Int) = Ticket(revision, index)
+  fun accepts(ticket: Ticket, index: Int) = wantsPlayback && ticket.revision == revision && ticket.index == index
+}
