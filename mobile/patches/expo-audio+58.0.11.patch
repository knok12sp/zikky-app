+package expo.modules.audio
+import org.junit.Assert.*
+import org.junit.Test
+class SleepAfterTrackTest {
+  @Test fun finishTimerStopsBeforeAnyRepeatOrNextDecision() {
+    val gate = PlaybackGate()
+    gate.play()
+    gate.stopAfterTrack = true
+    assertTrue(gate.finishTrack())
+    assertFalse(gate.wantsPlayback)
+    assertFalse(gate.stopAfterTrack)
+    assertFalse(gate.finishTrack())
+    gate.play()
+    assertFalse(gate.finishTrack())
+    assertTrue(gate.wantsPlayback)
+  }
+  @Test fun pauseDoesNotConsumeAnArmedEndOfTrackTimer() {
+    val gate = PlaybackGate()
+    gate.stopAfterTrack = true
+    gate.pause()
+    assertFalse(gate.finishTrack())
+    assertTrue(gate.stopAfterTrack)
+    gate.play()
+    assertTrue(gate.finishTrack())
+  }
+}
