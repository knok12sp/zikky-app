+package expo.modules.audio
+
+import androidx.media3.common.Player
+import java.lang.reflect.Proxy
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class PlayRequestingPlayerTest {
+  @Test fun mediaButtonsUsePlaylistIntentAndQueue() {
+    val rawCalls = mutableListOf<String>()
+    val raw = Proxy.newProxyInstance(Player::class.java.classLoader, arrayOf(Player::class.java)) { _, method, _ ->
+      rawCalls.add(method.name)
+      when (method.returnType) {
+        java.lang.Boolean.TYPE -> false
+        java.lang.Integer.TYPE -> 0
+        java.lang.Long.TYPE -> 0L
+        else -> null
+      }
+    } as Player
+    val actions = mutableListOf<String>()
+    val player = PlayRequestingPlayer(raw,
+      onPlay = { actions.add("play") }, onPause = { actions.add("pause") },
+      onNext = { actions.add("next") }, onPrevious = { actions.add("previous") })
+    player.play()
+    player.pause()
+    player.setPlayWhenReady(true)
+    player.setPlayWhenReady(false)
+    player.seekToNext()
+    player.seekToNextMediaItem()
+    player.seekToPrevious()
+    player.seekToPreviousMediaItem()
+    assertEquals(listOf("play", "pause", "play", "pause", "next", "next", "previous", "previous"), actions)
+    assertEquals(emptyList<String>(), rawCalls)
+  }
+}
