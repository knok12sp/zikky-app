{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Zikky desktop window capabilities",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ]
    }
  ]
}
